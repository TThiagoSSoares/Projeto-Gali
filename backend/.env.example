# =====================================================================
# CONFIGURAÇÃO DO BACKEND
# =====================================================================

NODE_ENV=development
PORT=5000

# --- Banco de dados PostgreSQL ---
# Em docker-compose o host é "db"; em local use "localhost"
DATABASE_URL=postgresql://sorocaba:sorocaba@localhost:5432/sorocaba_logistics
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sorocaba_logistics
DB_USER=sorocaba
DB_PASSWORD=sorocaba

# --- Autenticação ---
JWT_SECRET=troque-essa-chave-em-producao-pelo-menos-32-caracteres-longos
JWT_EXPIRATION=24h

# --- Coordenadas de Sorocaba para Open-Meteo ---
SOROCABA_LAT=-23.5015
SOROCABA_LON=-47.4526

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Limites de alerta ---
ALERT_PRECIPITACAO_MM=20
ALERT_CAPACIDADE_PCT=80
